[Unit]
Description=Photon HTTPS Proxy Instance %i
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/photon-proxy
ExecStart=/usr/bin/python3 /root/photon-proxy/https_proxy.py --port 808%i
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=photon-proxy-%i

[Install]
WantedBy=multi-user.target
