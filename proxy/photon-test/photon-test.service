[Unit]
Description=Photon Proxy Integration Tests
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/photon-test
ExecStart=/usr/bin/python3 /root/photon-test/integration_tests.py
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=photon-test

[Install]
WantedBy=multi-user.target
