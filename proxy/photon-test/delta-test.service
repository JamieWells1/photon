[Unit]
Description=Delta Proxy Integration Tests
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/delta-test
ExecStart=/usr/bin/python3 /opt/delta-test/integration_tests.py
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=delta-test

[Install]
WantedBy=multi-user.target
