[Unit]
Description=Photon HTTPS Proxy Instance %i
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/photon-proxy
ExecStart=/usr/bin/python3 -m uvicorn https_proxy:app --host 0.0.0.0 --port 808%i --workers 1
Restart=always
RestartSec=10

# Environment
Environment="PYTHONUNBUFFERED=1"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=photon-proxy-%i

[Install]
WantedBy=multi-user.target
